# Copy to .env at the repo root. Leave provider keys blank to run demo mode.
# Docker Compose reads this file when it exists. Defaults in docker-compose.yml
# are enough for demo mode.

NODE_ENV=development
LOG_LEVEL=info

# Postgres / Redis. Inside Compose these are overridden to service DNS names.
DATABASE_URL=postgresql://alphatape:alphatape@localhost:54329/alphatape
REDIS_URL=redis://localhost:63799/0

# Auth. Change this before any shared deployment.
JWT_SECRET=dev-only-change-me-please-32chars
API_HOST=0.0.0.0
API_PORT=3848
WEB_ORIGIN=http://localhost:3847
RATE_LIMIT_MAX=180

# auto = demo when no market-data key is set, live otherwise.
# demo = always synthetic demo data. live = never fall back to demo numbers.
DATA_MODE=auto

# Worker schedules (milliseconds)
DEMO_TICK_MS=2000
QUOTE_REFRESH_MS=60000
FUNDAMENTAL_REFRESH_MS=21600000
NEWS_REFRESH_MS=900000
BARS_REFRESH_MS=1800000
WORKER_METRICS_PORT=3849

# Optional email for alerts. Left blank, alerts stay in-app + websocket.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional OpenAI-compatible chat completions API. Blank disables AI text.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Market data. Each adapter turns on only when its key is set. ---
# Finnhub quotes, recommendations, price targets, insiders, news, websocket trades.
# Free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# Financial Modeling Prep fundamentals, grades, targets, insider statistics.
# Free tier: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable

# Polygon snapshots and aggregates (US listings only; no TASE).
# Free tier: https://polygon.io/dashboard/signup
POLYGON_API_KEY=

# Twelve Data quotes, series, RSI/MACD/SMA. TASE via exchange=TASE.
# Free tier: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Alpha Vantage fallback quotes and daily bars. Free tier is about 25 requests/day.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Unofficial Yahoo Finance via yahoo-finance2. Disabled unless exactly "true".
# No key. Not a licensed feed. Source is labeled yahoo-unofficial.
YAHOO_UNOFFICIAL_ENABLED=false

# These keys are ignored. Seeking Alpha, TipRanks, and MarketWatch have no
# public official API in this app and are not scraped. A commercial license
# (for example TipRanks or Seeking Alpha via a licensed RapidAPI product)
# would require replacing the stub.
SEEKING_ALPHA_API_KEY=
TIPRANKS_API_KEY=
MARKETWATCH_API_KEY=

# Browser URLs. The browser runs on the host, so these stay on localhost
# even when the web app itself runs in Docker.
NEXT_PUBLIC_API_URL=http://localhost:3848
NEXT_PUBLIC_WS_URL=ws://localhost:3848/ws
